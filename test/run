#!/usr/bin/env bash
# Every test the compiler has.
#
#   ./test/run           run them with the compiler itself (needs ./bootstrap)
#
# There are two kinds. The unit suites are Hive files declaring `test` blocks:
# they call the compiler's own passes and assert about what came back, and
# `hive test` finds every one under this directory. The end-to-end suite
# compiles whole programs and runs them, which is the one part a Hive test
# cannot do for itself.
set -uo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
root="$here/.."

runner="$root/hive"

if [ ! -x "$root/src/hivec" ] && [ ! -x "$root/src/hivec.exe" ]; then
	echo "test/run: the compiler has not been built yet. Run ./bootstrap" >&2
	exit 1
fi

echo "Running the suites with the compiler itself."
echo

failed=0

# Passing tests and coverage are left out: each suite's tally, and any failure.
if ! (cd "$root" && "$runner" test test) 2>&1 | grep -vE '^$|^  (PASS  |coverage: |never exercised: )'; then
	failed=$((failed + 1))
fi

echo
echo "End to end:"
if ! "$here/e2e/run"; then
	failed=$((failed + 1))
fi

echo
echo "Driving a window:"
if ! "$here/window/run"; then
	failed=$((failed + 1))
fi

echo
if [ "$failed" -eq 0 ]; then
	echo "Everything passed."
else
	echo "$failed suite(s) failed."
	exit 1
fi
